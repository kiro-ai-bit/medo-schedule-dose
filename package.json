{
  "name": "medo-schedule-dose",
  "version": "0.1.0",
  "private": true,
  "description": "Medo Schedule & Dose Service \u2014 schedules, materialized dose rows, outcome lifecycle",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch WebAPI/server.ts",
    "start": "tsx WebAPI/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@kiro-ai-bit/contracts": "0.1.0",
    "@kiro-ai-bit/eventing": "0.1.0",
    "@kiro-ai-bit/rate-limit": "0.1.0",
    "@sentry/node": "11.17.0",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "fastify-type-provider-zod": "7.0.0",
    "jose": "6.2.18",
    "luxon": "3.7.2",
    "node-cron": "4.6.0",
    "pg": "8.16.3",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@eslint/js": "10.0.1",
    "@kiro-ai-bit/eslint-config": "0.1.0",
    "@kiro-ai-bit/test-utils": "0.1.0",
    "@kiro-ai-bit/tsconfig": "0.1.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "26.6.7",
    "@types/pg": "8.15.5",
    "drizzle-kit": "0.31.11",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
